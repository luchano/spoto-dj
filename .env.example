SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8000/callback
SECRET_KEY=change_this_to_a_random_string
GETSONGBPM_API_KEY=your_getsongbpm_api_key_here
LASTFM_API_KEY=your_lastfm_api_key_here

# ── Local audio pipeline (spotdl + essentia) ────────────────────────────────
# Set to "true" to use local analysis instead of GetSongBPM + Last.fm.
# Requires: pip install spotdl essentia-tensorflow
# Then download models: python -c "from essentia_analysis import download_models; download_models()"
USE_LOCAL_ANALYSIS=false

# Path to a Netscape-format cookies.txt from your YouTube account.
# With YouTube Premium cookies, spotdl downloads at 256 kbps instead of 128 kbps.
# Export with browser extension: "Get cookies.txt LOCALLY" (Chrome/Firefox).
YOUTUBE_COOKIE_FILE=
