SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
# Must be registered EXACTLY (host + port + path) in the Spotify developer
# dashboard. dev.sh derives its port from PORT (or from this URI) so the
# server and the OAuth callback always stay on the same port.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback
# PORT=8000
SECRET_KEY=change_this_to_a_random_string
GETSONGBPM_API_KEY=your_getsongbpm_api_key_here
LASTFM_API_KEY=your_lastfm_api_key_here

# ── Local audio pipeline (zotify + essentia) ────────────────────────────────
# Set to "true" to use local analysis instead of GetSongBPM + Last.fm.
#
# One-time setup:
#   1. .venv/bin/pip install essentia-tensorflow
#   2. .venv/bin/python -c "from essentia_analysis import download_models; download_models()"
#   3. /opt/homebrew/bin/python3.12 -m venv .venv-dl
#      .venv-dl/bin/pip install git+https://github.com/Googolplexed0/zotify.git
#   4. Run any zotify download once in a terminal and complete the browser
#      OAuth login (a burner Spotify account is recommended — free tier is
#      enough, downloads are 96 kbps which is plenty for analysis).
USE_LOCAL_ANALYSIS=false

# Optional overrides (defaults shown):
# ZOTIFY_BIN=.venv-dl/bin/zotify
# ZOTIFY_RATE_LIMITER=1.0     # 1.0 = download at playback speed (recommended)
# ZOTIFY_TIMEOUT=900          # seconds per track before giving up
# ZOTIFY_PACING_JITTER=5      # random extra wait (s) between downloads
